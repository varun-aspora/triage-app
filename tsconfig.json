{
  "compilerOptions": {
    // Environment. The runtime is Node >= 22.19; Bun runs installs, scripts and unit tests.
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "allowJs": true,
    "types": ["bun", "node"],

    // Bundler mode with explicit .ts import extensions, so Node type stripping
    // can run src/ directly (bin/triage.mjs) and Vite can bundle it.
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },
  "include": [
    "*.ts",
    "src/**/*.ts",
    "test/**/*.ts",
    "scripts/**/*.ts",
    "evals/**/*.ts",
    "bin/**/*.mjs"
  ],
  "exclude": ["node_modules", "dist", ".data", "tmp"]
}
