{
  "entity": "rtl",
  "aliases": [],
  "services": {
    "workflow": {
      "db": "RTL_WORKFLOW_DB_URL",
      "api": "RTL_WORKFLOW_API_URL",
      "quickwit_service": "workflow-op",
      "repo": "workflow-op",
      "note": "RTL copy; Shivalik copy is ssfb:workflow. The log service may be workflow-v2, confirm when investigating"
    },
    "banking": {
      "db": "RTL_BANKING_DB_URL",
      "api": "RTL_BANKING_API_URL",
      "quickwit_service": "banking-service",
      "repo": "banking-service",
      "note": "log service name is unverified"
    },
    "kyc": {
      "db": "RTL_KYC_DB_URL",
      "api": "RTL_KYC_API_URL",
      "quickwit_service": "kyc-service",
      "repo": "kyc-service",
      "note": "log service name is unverified"
    }
  },
  "quickwit_fields": ["service", "level", "message", "error", "raw_message", "timestamp"],
  "quickwit": {
    "transport": "RTL_QUICKWIT_TRANSPORT",
    "index": "RTL_QUICKWIT_INDEX",
    "max_concurrency": "RTL_QUICKWIT_MAX_CONCURRENCY",
    "max_hits": "RTL_QUICKWIT_MAX_HITS",
    "http": { "url": "RTL_QUICKWIT_URL", "auth": "RTL_QUICKWIT_AUTH", "token": "RTL_QUICKWIT_TOKEN" },
    "qw": { "context": "RTL_QW_CONTEXT" }
  },
  "kube": { "context_env": "RTL_KUBE_CONTEXT", "aws_profile_env": "RTL_AWS_PROFILE" },
  "repos_extra": ["go-commons", "java-commons"]
}
