{
  "name": "triage-app",
  "type": "module",
  "private": true,
  "bin": {
    "triage": "bin/triage.mjs"
  },
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "gen": "bun scripts/gen-indexes.ts",
    "postinstall": "bun run gen",
    "test": "bun test ./src ./test ./scripts ./integrations",
    "test:contract": "bun run gen && vitest run",
    "typecheck": "bun run gen && bun run typecheck:raw",
    "typecheck:raw": "tsc --noEmit -p .",
    "build": "bun run gen && bun run build:raw",
    "build:raw": "vite build",
    "triage": "node bin/triage.mjs",
    "serve": "node bin/triage-server.mjs",
    "evals:classifier": "node bin/triage.mjs evals classifier",
    "ci": "bun scripts/ci.ts"
  },
  "dependencies": {
    "@daytonaio/sdk": "^0.216.1",
    "@earendil-works/pi-ai": "0.83.0",
    "@flue/cli": "2.0.8",
    "@flue/postgres": "2.0.8",
    "@flue/runtime": "2.0.8",
    "@flue/vite": "2.0.8",
    "@hono/node-server": "^2.1.1",
    "commander": "^15.0.0",
    "dotenv": "^18.0.3",
    "e2b": "^2.51.0",
    "hono": "4.12.32",
    "just-bash": "^3.4.2",
    "libpg-query": "^18.1.5",
    "miscreant": "^0.3.2",
    "pg": "^8.23.0",
    "pgvector": "^0.3.0",
    "ulidx": "^2.4.1",
    "valibot": "^1.5.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^22.19",
    "@types/pg": "^8.23.1",
    "promptfoo": "^0.123.1",
    "typescript": "7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
