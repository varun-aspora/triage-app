# .env.example — triage-app
#
# One .env per deployment. No variable name encodes prod or stage; a stage
# deployment is simply a .env whose values point at stage hosts.
#
# Setup:  cp -n .env.example .env
# Check:  triage doctor          (validates keys, probes reachability, never reads customer data)
#
# Conventions
#   <ENTITY>_<SERVICE>_DB_URL     postgresql://user:pass@host:port/db?application_name=triage
#   <ENTITY>_<SERVICE>_API_URL    base URL that http_call `path` and api.rules `api` are appended to
#   <ENTITY>_QUICKWIT_*           one Quickwit per entity, bearer token (Q2)
#   percent-encode @ % : / inside passwords (@ -> %40, % -> %25, : -> %3A, / -> %2F)
#
# Hostnames are filled in where they are known today (Q16, D41). Credentials are
# always blank; a URL still containing <user> or <password> is rejected by the
# doctor. A blank value disables the feature that needs it; `triage doctor` lists
# what is disabled and why. The runtime never writes to this file.

############################################################################
# Runtime
############################################################################
TRIAGE_HOME=                        # must come from the shell (export TRIAGE_HOME=/abs/dir); a value here is ignored.
                                    # The dir holding this .env, resources/, knowledge/, .data/; .env is loaded from here, never from cwd
TRIAGE_ENV_LABEL=                   # shown in reports and audit lines only. Code must never branch on it (a test enforces this)
TRIAGE_DEPLOY_MODE=local            # local | server. The ONLY variable code branches on, and only in preflight (D32):
                                    #   local  = this process owns the network path: preflight brings the tunnel up, runs kube login, probes hosts
                                    #   server = infra owns the path: preflight only probes
                                    # Preflight failures are warnings to the caller, never a blocked run. Orthogonal to stage/prod.
TRIAGE_ENTITIES=ssfb,atspl,rtl      # entities enabled in this deployment; a request may narrow, never widen
TRIAGE_DATA_DIR=./.data             # run folders, token cache, fixtures staging
TRIAGE_AUDIT_LOG=./.data/audit.jsonl
TRIAGE_RUNS_DIR=./.data/runs
TRIAGE_REPOS_DIR=                   # dir holding the checked-out repos with .codegraph indexes; branches pinned in resources/repos.json (D37)
TRIAGE_KNOWLEDGE_DIR=./knowledge

# Flue persistence (D38)
TRIAGE_DB_PROVIDER=sqlite           # sqlite | postgres
TRIAGE_DB_URL=./.data/triage.sqlite # file path for sqlite, postgresql:// DSN for postgres

# Run store (D43). Follows TRIAGE_DB_PROVIDER: postgres -> schema `triage` on TRIAGE_DB_URL with pgvector; sqlite -> folder provider under TRIAGE_RUNS_DIR.
# One store per deployment: a stage .env and a prod .env must never share a schema or a runs dir.
TRIAGE_RUNS_RETENTION_DAYS=365      # time-based retention applied by a scheduled job; blank = keep
TRIAGE_PRIOR_CASES=false            # true: top similar past cases (structured projection, ids stripped) go into the orchestrator's initial data; never to the classifier

# Approval for anything that leaves the run folder (D39)
TRIAGE_APPROVAL_MODE=cli            # cli (v1: interactive y/N or --yes --approved-by) | slack (v2: Yes/No/Comment buttons, signed interaction)

# Mock mode is ON by default. Real calls happen only when an operator sets this to false.
TRIAGE_MOCK_MODE=true               # true: every I/O tool (DB, HTTP, Quickwit, CBS, Slack read) answers from fixtures; preflight is skipped
TRIAGE_MOCK_STRICT=true             # true: a fixture miss fails the tool call loudly instead of returning an empty result
TRIAGE_RECORD_FIXTURES=false        # true: record redacted fixtures from real runs (requires MOCK_MODE=false)
TRIAGE_FIXTURES_DIR=./fixtures

# Per-run budgets (enforced in the gate, counted per run_id)
TRIAGE_MAX_TOOL_CALLS_PER_RUN=120
TRIAGE_MAX_TASKS_PER_RUN=12         # subagent delegations
TRIAGE_MAX_RESPONSE_BYTES_PER_CALL=1048576  # one tool response is cut at this size (1 MiB)
TRIAGE_MAX_BYTES_PER_RUN=20971520   # total tool response bytes in one run (20 MiB)
TRIAGE_RUN_TIMEOUT_MS=900000        # Flue durability timeout for one run (15 min)
TRIAGE_RUN_MAX_ATTEMPTS=2           # Flue durability maxAttempts; keep low for prod reads
TRIAGE_HTTP_TIMEOUT_MS=30000
TRIAGE_DEFAULT_LOOKBACK_DAYS=7      # log/DB window starts this many days before the first thread message

# SQL (D33): every sql_select call runs as BEGIN READ ONLY + SET LOCAL timeouts + one SELECT + COMMIT
TRIAGE_SQL_MAX_ROWS=200
TRIAGE_SQL_STATEMENT_TIMEOUT_MS=30000
TRIAGE_SQL_LOCK_TIMEOUT_MS=2000
TRIAGE_REQUIRE_READONLY_DB_ROLE=false  # false: a writable DB role is a doctor WARNING. true: it blocks real mode for that entity (set once infra provisions read-only roles, Q6/Q23)

############################################################################
# Models (pi-ai specifiers: provider/model). Registered once in src/models.ts.
# Tier models may be anthropic, openai or local ollama. openrouter is allowed
# for the classifier only, which sees the redacted thread (Q21).
############################################################################
MODEL_CLASSIFIER=                   # e.g. ollama/qwen3:8b | anthropic/claude-haiku-4-5 | openai/gpt-5-mini | openrouter/<vendor>/<model>
MODEL_TIER_CHEAP=                   # e.g. anthropic/claude-haiku-4-5 (may equal MODEL_TIER_MID)
MODEL_TIER_MID=                     # e.g. anthropic/claude-sonnet-5
MODEL_TIER_STRONG=                  # e.g. anthropic/claude-opus-5-5 | openai/gpt-5.5. Also used for deep investigators and escalated synthesis. MUST accept image input (D36; doctor checks)
MODEL_CODE_WALKER=                  # blank = MODEL_TIER_STRONG
MODEL_THINKING_CHEAP=off
MODEL_THINKING_MID=low
MODEL_THINKING_STRONG=high
MODEL_EMBEDDING=                    # e.g. ollama/nomic-embed-text (default posture: local, nothing leaves the machine) | openai/text-embedding-3-small. Embeds persisted-profile text only (D43)

# Provider credentials (names are what pi-ai / Flue read)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=                    # e.g. http://localhost:11434/v1 ; blank disables the ollama provider

# Evals (D42). Only read when this TRIAGE_HOME is an eval home. An eval home must
# have every entity credential below blank; the eval driver refuses to start otherwise
# and forces mock strict. Eval tier models use the MODEL_TIER_* keys above.
TRIAGE_EVAL_JUDGE_MODEL=            # llm-rubric judge; different model family from the tiers under test; never openrouter; missing = evals fail, no fallback
TRIAGE_EVAL_MAX_COST_USD=           # suite spend cap computed by the driver from pi-ai model cost metadata; blank = no cap

############################################################################
# HTTP API (src/app.ts). Server refuses to start without an auth token.
############################################################################
TRIAGE_HTTP_PORT=3000
TRIAGE_HTTP_AUTH_TOKEN=             # bearer required on every route
TRIAGE_HTTP_ALLOW_SLACK_POST=false  # keep false until TRIAGE_APPROVAL_MODE=slack can prove approval via a signed Slack interaction

############################################################################
# Slack. Read happens in ingress; write only via `triage post` / POST .../post-to-slack after approval.
############################################################################
SLACK_BOT_TOKEN=                    # scopes: channels:history, groups:history, files:read, chat:write, users:read.email. Blank: use --thread-file input instead
SLACK_SIGNING_SECRET=               # Slack bot channel (v2, HTTP Events API)
SLACK_REVIEWER_EMAIL=               # tagged on posted reports
SLACK_FALLBACK_GROUP_HANDLE=        # used when the reviewer is inactive or is the sender

############################################################################
# Sandbox (D45). One Flue sandbox on Triage, inherited by every delegate. The model's only shell.
############################################################################
TRIAGE_SANDBOX_PROVIDER=virtual     # virtual | e2b | daytona. virtual = just-bash in memory, network off, python on. `local` is refused.
TRIAGE_SANDBOX_PYTHON=true          # virtual only: enable python3 (CPython in WebAssembly)
TRIAGE_SANDBOX_TIMEOUT_MS=30000     # per command
E2B_API_KEY=                        # e2b only. Remote backends receive persisted-profile (masked) text only
DAYTONA_API_KEY=                    # daytona only
DAYTONA_API_URL=                    # daytona only; blank = provider default

############################################################################
# Code navigation
############################################################################
CODEGRAPH_BIN=codegraph
QW_BIN=qw                           # Quickwit SSO CLI, used by entities with <ENTITY>_QUICKWIT_TRANSPORT=qw (D44); login is interactive, checked by preflight
CODEGRAPH_SYNC_BEFORE_QUERY=true    # run `codegraph sync` once per repo per run (~0.6s no-op)

############################################################################
# Repo checkouts under TRIAGE_REPOS_DIR (D37, D46). `triage repos sync` clones a
# missing repo and updates the rest to the branch pinned in resources/repos.json.
############################################################################
TRIAGE_GIT_PROTOCOL=ssh             # ssh: git@<host>:<org>/<repo>.git | https: https://<host>/<org>/<repo>.git. Existing clones of the same repo are switched over
TRIAGE_GIT_HOST=github.com
TRIAGE_GIT_ORG=Vance-Club           # a pin with its own `remote` in repos.json ignores this
TRIAGE_GIT_HTTPS_TOKEN=             # https only: a token with read access to the org's repos. Sent to git through its environment, never in argv, a URL or .git/config. Blank: the host's git credential helper
# Automatic sync (D47). Point TRIAGE_REPOS_DIR at a folder used only for this: sync checks out the pinned branch in every clean clone.
TRIAGE_REPOS_SYNC_INTERVAL=24h      # longest the checkouts go without a sync: 30m, 2h, 6h, 24h, 1d ... Blank = 24h
TRIAGE_REPOS_SYNC_INTERFACES=cli,http,claude-code,slack  # where it runs: a run started on a listed interface syncs first when the last sync is older than the interval, and waits for it. http also runs a timer in the server. none = off. Not in mock mode. `triage repos sync` and POST /repos/sync always work

############################################################################
# Entity: SSFB (Shivalik). Registry: resources/ssfb.entity.json
############################################################################
# Postgres readers. Today all nine go through one SSH forward on localhost (see tunnel below);
# the RDS reader endpoint is read-only by topology.
SSFB_HARBOR_DB_URL=postgresql://<user>:<password>@localhost:55432/harbor_db?application_name=triage
SSFB_RHYTHM_DB_URL=postgresql://<user>:<password>@localhost:55432/rhythm_db?application_name=triage
SSFB_GUARDIAN_DB_URL=postgresql://<user>:<password>@localhost:55432/guardian_db?application_name=triage
SSFB_COMMS_DB_URL=postgresql://<user>:<password>@localhost:55432/comms_db?application_name=triage
SSFB_WORKFLOW_DB_URL=postgresql://<user>:<password>@localhost:55432/workflow_op_db?application_name=triage   # Shivalik copy of workflow-op
SSFB_COHORT_DB_URL=postgresql://<user>:<password>@localhost:55432/cohort_db?application_name=triage           # owner: cohort-service (Q10)
SSFB_PDFGEN_DB_URL=postgresql://<user>:<password>@localhost:55432/pdfgen_db?application_name=triage
SSFB_REMINDER_DB_URL=postgresql://<user>:<password>@localhost:55432/reminder_db?application_name=triage
SSFB_BRO_DB_URL=postgresql://<user>:<password>@localhost:55432/bro_db?application_name=triage

# Admin / debug APIs (GET allowed by default; other methods only where resources/ssfb.api.rules.json allows them; the file ships empty)
SSFB_HARBOR_API_URL=http://aspora.prod.shivalik.in:9443/harbor
SSFB_RHYTHM_API_URL=http://aspora.prod.shivalik.in:9443/rhythm
SSFB_GUARDIAN_API_URL=              # session/phone lookups; blank if not exposed
SSFB_BRO_API_URL=http://aspora.prod.shivalik.in:9443/bro
SSFB_BRO_ADMIN_TOKEN=               # attached by the registry's per-service auth config
SSFB_COHORT_API_URL=                # blank until known

# Harbor field encryption (AES-SIV, deterministic). When set, investigate_ssfb gets
# encrypt_lookup_value and decrypt_fields (D34). Plaintext is masked on persist.
SSFB_HARBOR_FIELD_ENC_KEY=

# Logs (D44): transport per entity. SSFB uses http, a direct REST call to SSFB_QUICKWIT_URL.
# ATSPL and RTL use qw, the SSO CLI, with --context on every call.
# qw takes --since only: the window's upper bound is dropped and the report says so (Q28 default).
# qw audit lines are matched to ours by timestamp, not by run_id (Q29 default).
SSFB_QUICKWIT_TRANSPORT=http        # qw | http
SSFB_QW_CONTEXT=                    # qw transport only; SSFB uses http
SSFB_QUICKWIT_INDEX=logs-v1
SSFB_QUICKWIT_URL=http://quickwit.vance.local:7080   # http transport only; VPN, no auth today
SSFB_QUICKWIT_AUTH=none             # http transport only: none | bearer
SSFB_QUICKWIT_TOKEN=                # http transport only
SSFB_QUICKWIT_MAX_CONCURRENCY=1     # single-CPU instance; raise only after it is resized
SSFB_QUICKWIT_MAX_HITS=500

# SSH forward to the RDS reader. Started by preflight in local mode, owned by infra in server mode (D32).
SSFB_DB_TUNNEL_REQUIRED=true
SSFB_DB_TUNNEL_BASTION=             # <user>@<bastion-ip>, no default on purpose
SSFB_DB_TUNNEL_IDENTITY_FILE=
SSFB_DB_TUNNEL_LOCAL_PORT=55432
SSFB_DB_TUNNEL_REMOTE_HOST=ssfb-aspora-prod-cluster.cluster-ro-czw0tnv9rhmd.ap-south-1.rds.amazonaws.com
SSFB_DB_TUNNEL_REMOTE_PORT=55432

# Kubernetes access for this entity (Q4). Used by preflight (kube login in local mode) and by cbs_call.
SSFB_KUBE_CONTEXT=
SSFB_AWS_PROFILE=

# Direct CBS (Finacle) via kubectl exec -> in-pod HTTP. Off by default.
# When enabled, `cbs_call` is mounted on investigate_ssfb: GET by default, POST only for
# rules in resources/ssfb.api.rules.json with service "finacle". kubectl runs on the laptop
# against EKS (Q26 default), so the two bastion keys below are unused.
SSFB_CBS_VIA_KUBECTL_ENABLED=false
SSFB_CBS_BASTION=                   # unused under the Q26 default (kubectl on the laptop); blank = SSFB_DB_TUNNEL_BASTION if the bastion hop comes back
SSFB_CBS_SSH_IDENTITY_FILE=         # unused under the Q26 default; blank = SSFB_DB_TUNNEL_IDENTITY_FILE
SSFB_CBS_K8S_NAMESPACE=eventbus-service
SSFB_CBS_POD_SELECTOR=app=eventbus
SSFB_CBS_CONTAINER=eventbus
SSFB_CBS_CREDS_SECRET=rhythm-service/rhythm-external-secret   # k8s secret holding the Finacle API username/password
SSFB_CBS_GATEWAY_URL=https://d6fgvcknkahpev3w4jdr273ane.apigateway.ap-mumbai-1.oci.customer-oci.com   # the `finacle` service
SSFB_CBS_OAUTH_SCOPE=https://31EE131E4270478CAE9E6F4A43B464BE.integration.ap-mumbai-1.ocp.oraclecloud.com:443urn:opc:resource:consumer::all
SSFB_CBS_SOURCE=                    # Finacle `Source` header
SSFB_CBS_SOURCE_IDENTIFIER=         # Finacle `SourceIdentifier` header
# The OAuth token cache lives under TRIAGE_DATA_DIR/cache, never in this file.

############################################################################
# Entity: ATSPL. Registry: resources/atspl.entity.json
############################################################################
ATSPL_PACKAGE_DB_URL=postgresql://<user>:<password>@vance-envoy-prod-mumbai-01-common-pg-db-reader.internal.genorim.xyz:65432/package_db?application_name=triage
ATSPL_PULSE_DB_URL=postgresql://<user>:<password>@vance-envoy-prod-mumbai-01-common-pg-db-reader.internal.genorim.xyz:65432/pulse_db?application_name=triage
ATSPL_PACKAGE_API_URL=              # exists (Q5); value not in the old workspace
ATSPL_PULSE_API_URL=                # exists (Q5); value not in the old workspace
ATSPL_QUICKWIT_TRANSPORT=qw         # qw | http. qw solves the OIDC proxy (browser SSO once, in preflight)
ATSPL_QW_CONTEXT=envoy-prod
ATSPL_QUICKWIT_INDEX=envoy-logs
ATSPL_QUICKWIT_URL=https://quickwit-proxy.vance.finance   # http transport only; needs a service token (Q2)
ATSPL_QUICKWIT_AUTH=bearer          # http transport only
ATSPL_QUICKWIT_TOKEN=               # http transport only
ATSPL_QUICKWIT_MAX_CONCURRENCY=1
ATSPL_QUICKWIT_MAX_HITS=500
ATSPL_KUBE_CONTEXT=
ATSPL_AWS_PROFILE=

############################################################################
# Entity: RTL. Registry: resources/rtl.entity.json
############################################################################
RTL_WORKFLOW_DB_URL=postgresql://<user>:<password>@vance-core-prod-london-01-common-pg-db-reader.internal.genorim.xyz:5432/workflow_op_db?application_name=triage   # RTL copy of workflow-op
RTL_BANKING_DB_URL=postgresql://<user>:<password>@vance-core-prod-london-01-common-pg-db-reader.internal.genorim.xyz:5432/banking_db?application_name=triage
RTL_KYC_DB_URL=postgresql://<user>:<password>@vance-core-prod-london-01-common-pg-db-reader.internal.genorim.xyz:5432/kyc_db?application_name=triage
RTL_WORKFLOW_API_URL=               # exists (Q5); value not in the old workspace
RTL_BANKING_API_URL=
RTL_KYC_API_URL=
RTL_QUICKWIT_TRANSPORT=qw           # qw | http
RTL_QW_CONTEXT=core-prod-london     # from the qw launch thread
RTL_QUICKWIT_INDEX=                 # run `qw indexes --context core-prod-london` to find it
RTL_QUICKWIT_URL=                   # http transport only; not documented
RTL_QUICKWIT_AUTH=bearer            # http transport only
RTL_QUICKWIT_TOKEN=                 # http transport only
RTL_QUICKWIT_MAX_CONCURRENCY=1
RTL_QUICKWIT_MAX_HITS=500
RTL_KUBE_CONTEXT=
RTL_AWS_PROFILE=
