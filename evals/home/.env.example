# evals/home/.env.example — template for an eval TRIAGE_HOME (D42)
#
# materialiseEvalHome(targetDir, repoRoot) in src/evals/make-home.ts writes
# <targetDir>/.env from this file with __REPO__ replaced by the repo root, and
# copies __REPO__/resources into <targetDir>/resources (the loader always reads
# resources from the home; there is no key for it).
#
# Same keys as the root .env.example. Every entity credential and host is blank,
# so nothing here can reach a real system even if mock mode were bypassed. The
# eval driver refuses to start if one is set (assertEvalHome in src/evals/home.ts)
# and forces mock strict with recording off. A test keeps the key set equal to
# the root .env.example.

############################################################################
# Runtime
############################################################################
TRIAGE_HOME=                        # shell only; materialiseEvalHome returns the path to export
TRIAGE_ENV_LABEL=eval               # display only
TRIAGE_DEPLOY_MODE=local            # preflight is skipped in mock mode
TRIAGE_ENTITIES=ssfb,atspl,rtl
TRIAGE_DATA_DIR=./.data
TRIAGE_AUDIT_LOG=./.data/audit.jsonl
TRIAGE_RUNS_DIR=./.data/runs
TRIAGE_REPOS_DIR=
TRIAGE_KNOWLEDGE_DIR='__REPO__/knowledge'

# Flue persistence (D38): sqlite only in an eval home
TRIAGE_DB_PROVIDER=sqlite
TRIAGE_DB_URL=./.data/triage.sqlite
TRIAGE_DB_RETRY_ATTEMPTS=100
TRIAGE_DB_RETRY_DELAY_MS=1000
TRIAGE_DB_RETRY_MAX_DELAY_MS=5000

# Run store (D43): folder provider under TRIAGE_RUNS_DIR
TRIAGE_RUNS_RETENTION_DAYS=
TRIAGE_PRIOR_CASES=false

# Approval (D39)
TRIAGE_APPROVAL_MODE=cli

# Mock mode: always on and strict, recording always off
TRIAGE_MOCK_MODE=true
TRIAGE_MOCK_STRICT=true
TRIAGE_RECORD_FIXTURES=false
TRIAGE_FIXTURES_DIR='__REPO__/fixtures'

# Per-run budgets
TRIAGE_MAX_TOOL_CALLS_PER_RUN=120
TRIAGE_MAX_TASKS_PER_RUN=12
TRIAGE_MAX_ASKS_PER_RUN=2
TRIAGE_MAX_RESPONSE_BYTES_PER_CALL=1048576
TRIAGE_MAX_BYTES_PER_RUN=20971520
TRIAGE_RUN_TIMEOUT_MS=900000
TRIAGE_RUN_MAX_ATTEMPTS=2
TRIAGE_HTTP_TIMEOUT_MS=30000
TRIAGE_DEFAULT_LOOKBACK_DAYS=7

# SQL (D33)
TRIAGE_SQL_MAX_ROWS=200
TRIAGE_SQL_STATEMENT_TIMEOUT_MS=30000
TRIAGE_SQL_LOCK_TIMEOUT_MS=2000
TRIAGE_SQL_RETRY_ATTEMPTS=20
TRIAGE_SQL_RETRY_DELAY_MS=1000
TRIAGE_SQL_RETRY_MAX_DELAY_MS=5000
TRIAGE_REQUIRE_READONLY_DB_ROLE=false

############################################################################
# Models. faux/* is the pi-ai fake provider the eval driver registers. To run
# a suite against real models, change these in the materialised .env only.
############################################################################
MODEL_CLASSIFIER=faux/classifier
MODEL_TIER_CHEAP=faux/cheap
MODEL_TIER_MID=faux/mid
MODEL_TIER_STRONG=faux/strong
MODEL_CODE_WALKER=                  # blank = MODEL_TIER_STRONG
MODEL_THINKING_CHEAP=off
MODEL_THINKING_MID=low
MODEL_THINKING_STRONG=high
MODEL_EMBEDDING=                    # blank or ollama/<model> only (D43)

# Provider credentials
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
TYPESAFE_API_KEY=

OPENAI_BASE_URL=
OLLAMA_BASE_URL=

# Evals (D42)
TRIAGE_EVAL_JUDGE_MODEL=            # blank = judge off
TRIAGE_EVAL_MAX_COST_USD=

############################################################################
# HTTP API
############################################################################
TRIAGE_HTTP_PORT=3000
TRIAGE_HTTP_AUTH_TOKEN=
TRIAGE_HTTP_ALLOW_SLACK_POST=false
TRIAGE_UI_ENV=non-production
TRIAGE_UI_DEV_PORT=5173

############################################################################
# Slack: all blank
############################################################################
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_REVIEWER_EMAIL=
SLACK_FALLBACK_GROUP_HANDLE=

############################################################################
# Sandbox (D45): virtual only in an eval home
############################################################################
TRIAGE_SANDBOX_PROVIDER=virtual
TRIAGE_SANDBOX_PYTHON=true
TRIAGE_SANDBOX_TIMEOUT_MS=30000
E2B_API_KEY=
DAYTONA_API_KEY=
DAYTONA_API_URL=

############################################################################
# Code navigation
############################################################################
CODEGRAPH_BIN=codegraph
QW_BIN=qw
CODEGRAPH_SYNC_BEFORE_QUERY=true

############################################################################
# Repo checkouts (D46). An eval home never syncs repos; the token stays blank.
############################################################################
TRIAGE_GIT_PROTOCOL=ssh
TRIAGE_GIT_HOST=                    # blank = github.com; no host names in an eval home
TRIAGE_GIT_ORG=Vance-Club
TRIAGE_GIT_HTTPS_TOKEN=
TRIAGE_REPOS_SYNC_INTERVAL=24h
TRIAGE_REPOS_SYNC_INTERFACES=none   # an eval home never syncs repos

############################################################################
# Entity: SSFB. Every credential and host blank.
############################################################################
SSFB_HARBOR_DB_URL=
SSFB_RHYTHM_DB_URL=
SSFB_GUARDIAN_DB_URL=
SSFB_COMMS_DB_URL=
SSFB_WORKFLOW_DB_URL=
SSFB_COHORT_DB_URL=
SSFB_PDFGEN_DB_URL=
SSFB_REMINDER_DB_URL=
SSFB_BRO_DB_URL=

SSFB_HARBOR_API_URL=
SSFB_RHYTHM_API_URL=
SSFB_GUARDIAN_API_URL=
SSFB_BRO_API_URL=
SSFB_BRO_ADMIN_TOKEN=
SSFB_COHORT_API_URL=

SSFB_HARBOR_FIELD_ENC_KEY=
SSFB_RHYTHM_FIELD_ENC_KEY=

SSFB_QUICKWIT_TRANSPORT=qw
SSFB_QW_CONTEXT=
SSFB_QUICKWIT_INDEX=logs-v1
SSFB_QUICKWIT_URL=
SSFB_QUICKWIT_AUTH=none
SSFB_QUICKWIT_TOKEN=
SSFB_QUICKWIT_MAX_CONCURRENCY=1
SSFB_QUICKWIT_MAX_HITS=500

SSFB_DB_TUNNEL_REQUIRED=
SSFB_DB_TUNNEL_BASTION=
SSFB_DB_TUNNEL_IDENTITY_FILE=
SSFB_DB_TUNNEL_LOCAL_PORT=
SSFB_DB_TUNNEL_REMOTE_HOST=
SSFB_DB_TUNNEL_REMOTE_PORT=

SSFB_KUBE_CONTEXT=
SSFB_AWS_PROFILE=
SSFB_INFRA_REPO=

SSFB_CBS_VIA_KUBECTL_ENABLED=false  # blank or false only
SSFB_CBS_BASTION=
SSFB_CBS_SSH_IDENTITY_FILE=
SSFB_CBS_K8S_NAMESPACE=
SSFB_CBS_POD_SELECTOR=
SSFB_CBS_CONTAINER=
SSFB_CBS_CREDS_SECRET=
SSFB_CBS_GATEWAY_URL=
SSFB_CBS_OAUTH_SCOPE=
SSFB_CBS_SOURCE=
SSFB_CBS_SOURCE_IDENTIFIER=

############################################################################
# Entity: ATSPL. Every credential and host blank.
############################################################################
ATSPL_CANOPY_DB_URL=
ATSPL_COHORT_DB_URL=
ATSPL_COMMS_DB_URL=
ATSPL_ENGAGE_DB_URL=
ATSPL_PACKAGE_DB_URL=
ATSPL_PULSE_DB_URL=
ATSPL_PACKAGE_API_URL=
ATSPL_PULSE_API_URL=
ATSPL_QUICKWIT_TRANSPORT=qw
ATSPL_QW_CONTEXT=
ATSPL_QUICKWIT_INDEX=envoy-logs
ATSPL_QUICKWIT_URL=
ATSPL_QUICKWIT_AUTH=bearer
ATSPL_QUICKWIT_TOKEN=
ATSPL_QUICKWIT_MAX_CONCURRENCY=1
ATSPL_QUICKWIT_MAX_HITS=500
ATSPL_KUBE_CONTEXT=
ATSPL_AWS_PROFILE=
ATSPL_INFRA_REPO=

############################################################################
# Entity: RTL. Every credential and host blank.
############################################################################
RTL_BANKING_DB_URL=
RTL_CANOPY_DB_URL=
RTL_COHORT_DB_URL=
RTL_COMMS_DB_URL=
RTL_KYC_DB_URL=
RTL_WORKFLOW_OP_DB_URL=
RTL_WORKFLOW_DB_URL=
RTL_WORKFLOW_API_URL=
RTL_BANKING_API_URL=
RTL_KYC_API_URL=
RTL_QUICKWIT_TRANSPORT=qw
RTL_QW_CONTEXT=
RTL_QUICKWIT_INDEX=
RTL_QUICKWIT_URL=
RTL_QUICKWIT_AUTH=bearer
RTL_QUICKWIT_TOKEN=
RTL_QUICKWIT_MAX_CONCURRENCY=1
RTL_QUICKWIT_MAX_HITS=500
RTL_KUBE_CONTEXT=
RTL_AWS_PROFILE=
RTL_INFRA_REPO=
